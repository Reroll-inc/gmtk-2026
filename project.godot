; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Heroless"
config/description="A journey to become a human again"
run/main_scene="uid://da8sgbng7wcgu"
config/features=PackedStringArray("4.6")
boot_splash/use_filter=false
boot_splash/image="uid://3s80i8kf1lcu"
config/icon="res://assets/icon.svg"

[autoload]

SignalBus="*uid://b8d2v4tciy2kr"
SignalLens="*uid://85rkx60vm7a7"

[debug]

gdscript/warnings/unused_parameter=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2

[display]

window/size/viewport_width=480
window/size/viewport_height=272
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/signal_lens/plugin.cfg")

[gui]

fonts/dynamic_fonts/use_oversampling=false
theme/default_font_multichannel_signed_distance_field=true
theme/custom="uid://cogqm6wn24nal"
theme/custom_font="uid://dwahb2b0ojivr"

